<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A plain .NET library, like Cosmos.Network.Ftp: it uses System.Net.Sockets
    and nothing from Cosmos. A Cosmos Gen3 kernel runs it on the kernel's
    network stack through the socket and DNS plugs, and on a desktop it runs
    as is, which is how the tests drive it.

    TLS is BouncyCastle's, all managed code: SslStream and the BCL's
    cryptography call OpenSSL, which a kernel does not have.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Cosmos.Network.Http</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Cosmos.Network.Http</PackageId>
    <Version>2.1.0</Version>
    <Title>Cosmos.Network.Http</Title>
    <Authors>Cosmos</Authors>
    <Company>Cosmos</Company>
    <Description>HTTP client for Cosmos Gen3 kernels.</Description>
    <PackageTags>cosmos;http;https;tls;client;kernel</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/CosmosOS/Cosmos.Network.Http</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CosmosOS/Cosmos.Network.Http</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../LICENSE.txt" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../resources/icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The roots https:// servers are checked against: Mozilla's, as curl extracts them (https://curl.se/docs/caextract.html). -->
    <EmbeddedResource Include="../../resources/cacert.pem" LogicalName="Cosmos.Network.Http.cacert.pem" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cosmos.Network.Http.Tests" />
  </ItemGroup>

</Project>
